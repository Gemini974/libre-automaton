# .env.example — copy to .env and fill in values

# Inference (required)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://api.ollama.com

# HTTP server port (Railway sets this automatically)
PORT=3000

# Revenue services (optional but recommended)
VERCEL_TOKEN=

# Payments (optional)
KOFI_WEBHOOK_SECRET=

# Auto-generated on first boot — do not fill
# AGENT_WALLET_PRIVATE_KEY=
# AGENT_API_KEY=
# AGENT_NAME=
